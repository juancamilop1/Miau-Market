# Django
DJANGO_SECRET_KEY=dev-cambiar-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Motor de BD: mysql (por defecto) | sqlite (desarrollo rapido, archivo Backend/db.sqlite3)
DB_ENGINE=mysql
SQLITE_PATH=db.sqlite3

# MySQL local. DB_PASSWORD = clave real de root (no dejar vacio).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=miau_market
# TiDB Cloud / MySQL remoto: DB_SSL=True y suele usar puerto 4000
DB_SSL=False

# CORS (desarrollo)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CORS_ALLOW_ALL_ORIGINS=True
# Produccion (Render + Cloudflare), ejemplo:
# CSRF_TRUSTED_ORIGINS=https://miau-market-api.onrender.com,https://miaumarket.pages.dev

# Gemini — IA del chatbot MiauBot (opcional)
# Obtener gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
