# Django
DJANGO_SECRET_KEY=genera-una-clave-segura-aqui
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (local). NO confundir DB_HOST con el host del frontend.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=miau_market

# CORS (desarrollo)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CORS_ALLOW_ALL_ORIGINS=True

# Gemini — IA del chatbot MiauBot (obligatorio en VPS)
# Obtener gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
